# 프론트엔드 컨테이너의 nginx 설정 템플릿.
# 컨테이너가 시작할 때 ${API_UPSTREAM}, ${NGINX_LOCAL_RESOLVERS}가 채워져 /etc/nginx/conf.d/default.conf가 된다.
# (nginx 자체 변수 $host 등은 환경 변수가 아니라서 그대로 남는다)

server {
    listen 80;
    server_name _;
    root /usr/share/nginx/html;

    # 화면 주소는 HashRouter(/#/home)라서 서버는 늘 / 만 받는다. SPA용 try_files 설정이 필요 없다.
    # 앱 밖에서 앱 주소를 만들 때(백엔드의 Google 로그인 성공 주소 등)도 반드시 /#/... 형태여야 한다.
    # #이 없는 /home 같은 주소로 오면 그런 파일이 없어서 404가 된다.
    location / {
        index index.html;
    }

    # index.html은 캐시하지 않는다. 새로 배포하면 바로 새 JS 파일 이름을 받게 하려고.
    location = /index.html {
        add_header Cache-Control "no-cache";
    }

    # 빌드한 JS·CSS는 파일 이름에 해시가 붙어 내용이 바뀌면 이름도 바뀐다. 오래 캐시해도 된다.
    location /assets/ {
        add_header Cache-Control "public, max-age=31536000, immutable";
    }

    # 개발 서버(vite.config.ts의 proxy)와 같은 일: /api 요청을 closet-service로 대신 전달한다.
    # 브라우저에게는 같은 출처로 보여서 백엔드에 CORS 설정이 없어도 로그인 세션 쿠키가 같이 간다.
    # 개발 서버의 '/api'와 똑같이 /api 자체와 /api로 시작하는 모든 주소를 받도록 끝에 /를 붙이지 않는다.
    location /api {
        # 주소를 변수로 두고 resolver를 지정하면, 백엔드가 아직 안 떠 있어도 nginx가 시작에 실패하지 않고
        # 요청이 올 때 주소를 찾는다 (그동안의 요청은 502).
        resolver ${NGINX_LOCAL_RESOLVERS} valid=10s ipv6=off;
        set $closet ${API_UPSTREAM};
        # 변수 proxy_pass에 경로를 붙이지 않았으므로 /api/auth/me가 그대로 전달된다.
        # 그래서 API_UPSTREAM에는 끝에 /나 경로를 붙이면 안 된다 (http://host:8081 O, http://host:8081/ X).
        # 붙이면 nginx가 요청 경로를 그 값으로 바꿔 모든 요청이 백엔드의 / 로 가고, 로그인이 안 된 것처럼 보인다.
        proxy_pass $closet;

        proxy_set_header Host $host;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
        proxy_set_header X-Forwarded-Host $host;
    }

    gzip on;
    gzip_types text/css application/javascript application/json image/svg+xml;
}
