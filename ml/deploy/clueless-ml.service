# ML API (옷 분석·코디 추천). setup_vm.sh 가 /etc/systemd/system/ 에 복사한다.
# 같은 VM의 백엔드만 부르므로 127.0.0.1 에만 연다 (외부 공개 안 함).
[Unit]
Description=Clueless ML API
After=network-online.target
Wants=network-online.target

[Service]
User=clueless
WorkingDirectory=/opt/clueless/ml
EnvironmentFile=/etc/clueless/ml.env
Environment=PYTHONUNBUFFERED=1
# 워커 1개: 모델이 프로세스마다 메모리에 올라가서(약 4.5GB) 늘리면 메모리가 배로 든다
ExecStart=/opt/clueless/ml/.venv/bin/uvicorn ml.api:app --host 127.0.0.1 --port 8000 --workers 1
Restart=always
RestartSec=5
# 메모리를 다 쓰면 VM 전체(백엔드·DB)가 멈추지 않게 ML만 정리되도록 상한
MemoryMax=7G
NoNewPrivileges=true
ProtectSystem=full
PrivateTmp=true

[Install]
WantedBy=multi-user.target
