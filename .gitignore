# Environment and credentials (.env.example must contain placeholders only)
.env
.env.*
!.env.example
/backend/certs/*
!/backend/certs/ca.crt
secrets/
credentials.json
service-account*.json
*.pem
*.key
*.p12
*.pfx

# Generated closet deploy override
/backend/compose.closet-image.yaml
/backend/compose.closet-image.yaml.tmp.*

# Frontend dependencies and output
node_modules/
dist/
.next/
coverage/

# Java / Spring Boot output (keep Gradle wrapper JAR trackable)
.gradle/
build/
target/
*.class

# Python environments and caches
.venv/
venv/
__pycache__/
*.py[cod]
.pytest_cache/
.mypy_cache/
.ruff_cache/
.ipynb_checkpoints/

# Local datasets, uploads and model weights (not all CSV/JSON/images)
**/data/raw/
**/data/processed/
uploads/
weights/
*.pt
*.pth
*.onnx
*.safetensors

# macOS metadata
.DS_Store
